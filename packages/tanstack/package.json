{
  "name": "@smart-table/tanstack",
  "version": "0.9.0-beta",
  "description": "TanStack Query and Router integrations for SmartTableJS — cached query data sources and router state sync.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "table",
    "grid",
    "tanstack",
    "tanstack-query",
    "tanstack-router",
    "smart-table"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@smart-table/core": ">=0.9.0-beta",
    "@tanstack/query-core": "^5"
  },
  "peerDependenciesMeta": {
    "@tanstack/query-core": {
      "optional": true
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@smart-table/core": "workspace:*",
    "@tanstack/query-core": "^5.62.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.1.0"
  }
}
